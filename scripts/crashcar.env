# user-facing crashcar launch parameters
# edit this file, then run from the repository root:
#   bash scripts/crashcar.sh

root=/fred/oz016/qliang/Eric_bless_SPIIR
run_id=20260629_1000
data_file=/fred/oz016/sunil/run_utils/frames_chache/frame_O3a.cache
detector_response_file=/fred/oz016/wguo/odds_ratio/O3a/chunk14/multi_det-BNS-LVK_inj/H1L1V1_1248134334_detrsp_map.xml
start_gps=1247911888
duration_hour=24

worker_number=2
bank_per_worker=8
# Optional Slurm partition override for smoke tests or site-specific routing.
slurm_partition=
bank_file=/fred/oz016/sunil/O3b_py3_banks
BG_accumulation_hour=3
zerolag_update_hour=1
tail_log_FAR=-2.5
SNR_series_logFAR_threshold=-4

# Parameters above injection_mode are common defaults for both normal O3 runs
# and the frozen-background injection workflow.  Values below may override
# those defaults for the no-injection BG stage or the injection stage.
injection_mode=False

#non-inject
# No-injection background stage.  Empty data/detrsp/segment/start/duration
# fields inherit the common values above.
injection_bg_data_file=
injection_bg_detector_response_file=
injection_bg_start_gps=
injection_bg_duration_hour=
# Optional smoke-test override; if set, it takes precedence over
# injection_bg_duration_hour.
injection_bg_duration_seconds=
injection_bg_segment_xml=
injection_bg_worker_number=1
injection_bg_bank_per_worker=8
injection_bg_accumulation_hour=24
# Optional smoke-test override; if set, it takes precedence over
# injection_bg_accumulation_hour.
injection_bg_accumulation_seconds=
injection_bg_seed_noninj_stats_loc=/fred/oz016/wguo/odds_ratio/O3a/chunk2/multi_det-BNS

#inject
# Injection foreground stage.  Empty data/detrsp/segment/start/duration fields
# inherit the common values above.
injection_file=
injection_data_file=
injection_detector_response_file=
injection_start_gps=
injection_duration_hour=
# Optional smoke-test override; if set, it takes precedence over
# injection_duration_hour.
injection_duration_seconds=
injection_segment_xml=
injection_worker_number=2
injection_bank_per_worker=4
injection_chunk_hour=1
# Optional smoke-test override; if set, it takes precedence over
# injection_chunk_hour.
injection_chunk_seconds=
# 90 keeps a full SNR-series evidence surface for injection chunks; final
# selection is done after frozen single-FAR assignment.
injection_snr_series_logFAR_threshold=90
