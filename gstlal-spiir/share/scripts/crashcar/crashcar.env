# Edit this file, then run: bash scripts/crashcar.sh

# This launch starts exactly one independent role.
crashcar_role=A
# Role B requires the exact <group>/A run root below.
# The B launch creates <group>/B beside it.
background_run_root=

root=/fred/oz016/qliang/Eric_bless_SPIIR
dof=120
save_dir=/fred/oz016/qliang/Eric_bless_SPIIR/runs
