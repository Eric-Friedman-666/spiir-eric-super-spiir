slurm_time=7-00:00:00
bank_file=/fred/oz016/sunil/O3b_py3_banks
tail_log_FAR=-2.5
SNR_series_logFAR_threshold=-4
zerolag_update_hour=1
worker_number=2
start_bank=0
bank_per_worker=8
single_BG_accumulation_hour=3
BG_update_hour=1

# Role A: complete normal no-injection SPIIR and live background producer.
data_file=/fred/oz016/sunil/run_utils/frames_chache/frame_O3a.cache
